# Copy to .env.prod on EC2 (or use as reference for ECS task env).
# Never commit .env.prod with real secrets.

DOCKERHUB_USERNAME=your-dockerhub-user
IMAGE_TAG=latest

# RDS (create in AWS Console or Terraform — see README)
DB_HOST=your-db.xxxxx.eu-west-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=puncher_db
DB_USER=postgres
DB_PASSWORD=change-me-strong-password

JWT_SECRET=change-me-long-random-secret-min-256-bits
JWT_EXPIRATION_MS=28800000

# Public URL of the app (browser). Use http:// until you add HTTPS.
APP_PUBLIC_URL=http://your-alb-dns.eu-west-1.elb.amazonaws.com
CORS_ORIGINS=http://your-alb-dns.eu-west-1.elb.amazonaws.com

# Baked into frontend image at build time — must match how the browser reaches the API.
# With ALB path routing: same host as the app (ALB forwards /api/* to backend).
NEXT_PUBLIC_API_URL=http://your-alb-dns.eu-west-1.elb.amazonaws.com

SERVER_PORT=8080

# Optional mail (schedule emails)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
